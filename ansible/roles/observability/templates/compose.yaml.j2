services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
    volumes:
      - type: bind
        source: ./prometheus/prometheus.yml
        target: /etc/prometheus/prometheus.yml
        read_only: true

      - type: bind
        source: ./prometheus/secrets/kube-state-metrics-password
        target: /etc/prometheus/secrets/kube-state-metrics-password
        read_only: true
        bind:
          create_host_path: false

      - type: volume
        source: prometheus-data
        target: /prometheus
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - observability

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_ADDR: 0.0.0.0
      GF_SERVER_HTTP_PORT: 3000
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "127.0.0.1:3000:3000"
    depends_on:
      - prometheus
    networks:
      - observability

  loki:
    image: {{ loki_image }}
    container_name: loki
    restart: unless-stopped
    command:
    - -config.file=/etc/loki/config.yml
    volumes:
    - ./loki/loki-config.yml:/etc/loki/config.yml:ro
    - loki-data:/loki
    networks:
    - observability

  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      - loki
    networks:
      - observability


  umami-db:
    image: {{ postgres_image }}
    container_name: umami-db
    restart: unless-stopped

    environment:
      POSTGRES_DB: "{{ umami_db_name }}"
      POSTGRES_USER: "{{ umami_db_user }}"
      POSTGRES_PASSWORD_FILE: /run/secrets/db-password

    volumes:
      - type: volume
        source: umami-db-data
        target: /var/lib/postgresql/data

      - type: bind
        source: ./umami/secrets/db-password
        target: /run/secrets/db-password
        read_only: true
        bind:
          create_host_path: false

    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U {{ umami_db_user }} -d {{ umami_db_name }}
      interval: 5s
      timeout: 5s
      retries: 10

    networks:
      - observability

  umami:
    image: {{ umami_image }}
    container_name: umami
    restart: unless-stopped
    init: true

    environment:
      DATABASE_URL: "postgresql://{{ umami_db_user }}:{{ umami_db_password | urlencode }}@umami-db:5432/{{ umami_db_name }}"
      APP_SECRET: "{{ umami_app_secret }}"
      TWO_FACTOR_ENCRYPTION_KEY: "{{ umami_two_factor_encryption_key }}"

    depends_on:
      umami-db:
        condition: service_healthy

    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://localhost:3000/api/heartbeat || exit 1
      interval: 10s
      timeout: 5s
      retries: 10

    networks:
      - observability

volumes:
  prometheus-data:
  grafana-data:
  loki-data:
  umami-db-data:
  caddy-data:
  caddy-config:
networks:
  observability:
    driver: bridge
    ipam:
      config:
        - subnet: 172.30.0.0/24