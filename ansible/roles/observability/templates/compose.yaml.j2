services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
    volumes:
      - type: bind
        source: ./prometheus/prometheus.yml
        target: /etc/prometheus/prometheus.yml
        read_only: true

      - type: bind
        source: ./prometheus/secrets/kube-state-metrics-password
        target: /etc/prometheus/secrets/kube-state-metrics-password
        read_only: true
        bind:
          create_host_path: false

      - type: volume
        source: prometheus-data
        target: /prometheus
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - observability

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_ADDR: 0.0.0.0
      GF_SERVER_HTTP_PORT: 3000
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "127.0.0.1:3000:3000"
    depends_on:
      - prometheus
    networks:
      - observability

  loki:
    image: {{ loki_image }}
    container_name: loki
    restart: unless-stopped
    command:
    - -config.file=/etc/loki/config.yml
    volumes:
    - ./loki/loki-config.yml:/etc/loki/config.yml:ro
    - loki-data:/loki
    networks:
    - observability

  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      - loki
    networks:
      - observability

volumes:
  prometheus-data:
  grafana-data:
  loki-data:
  caddy-data:
  caddy-config:
networks:
  observability:
    driver: bridge
    ipam:
      config:
        - subnet: 172.30.0.0/24