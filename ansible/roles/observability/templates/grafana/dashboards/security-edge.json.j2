{
  "id": null,
  "uid": "security-edge",
  "title": "Security / Edge",
  "description": "Edge security, bot/automation visibility and HTTP traffic investigation dashboard based on Traefik access logs.",
  "tags": [
    "platform",
    "security",
    "edge",
    "traefik"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({application=\"traefik\"}, cluster)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "label": "Host regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "ingress_namespace",
        "label": "Ingress namespace regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "service",
        "label": "Service regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "client_ip",
        "label": "Client IP regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "user_agent",
        "label": "User-Agent regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "description": "Current request rate through Traefik for the selected filters.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({application=\"traefik\",cluster=\"$cluster\"} | json | __error__=\"\" | RequestHost=~\"$host\" | KubernetesIngressNamespace=~\"$ingress_namespace\" | KubernetesServiceName=~\"$service\" | ClientHost=~\"$client_ip\" [1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "4xx error rate",
      "description": "Percentage of requests returning a downstream 4xx response.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate({application=\"traefik\",cluster=\"$cluster\"} | json | __error__=\"\" | RequestHost=~\"$host\" | KubernetesIngressNamespace=~\"$ingress_namespace\" | KubernetesServiceName=~\"$service\" | ClientHost=~\"$client_ip\" | DownstreamStatus >= 400 | DownstreamStatus < 500 [5m])) / sum(rate({application=\"traefik\",cluster=\"$cluster\"} | json | __error__=\"\" | RequestHost=~\"$host\" | KubernetesIngressNamespace=~\"$ingress_namespace\" | KubernetesServiceName=~\"$service\" | ClientHost=~\"$client_ip\" [5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "description": "Percentage of requests returning a downstream 5xx response.",
