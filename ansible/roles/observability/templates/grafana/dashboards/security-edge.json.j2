                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Unique external client IPs",
      "description": "Distinct public client IP addresses observed during the last 5 minutes. RFC1918, loopback, link-local and CGNAT ranges are excluded.",
