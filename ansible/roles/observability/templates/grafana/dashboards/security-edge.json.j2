        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": "Loki",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (ClientHost) (count_over_time({application=\"traefik\",cluster=\"$cluster\"} | json | __error__=\"\" | RequestHost=~\"$host\" | KubernetesIngressNamespace=~\"$ingress_namespace\" | KubernetesServiceName=~\"$service\" | ClientHost=~\"$client_ip\" | ClientHost!~\"^(10\\\\..*|127\\\\..*|169\\\\.254\\\\..*|192\\\\.168\\\\..*|172\\\\.(1[6-9]|2[0-9]|3[01])\\\\..*|100\\\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\\\..*)$\" [5m])))"
