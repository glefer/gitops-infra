global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node
    static_configs:
      - targets:
          - host.docker.internal:9100
        labels:
          instance: platform-observability-01

      - targets:
          - 135.125.75.237:9100
        labels:
          instance: platform-app-01

  - job_name: kube-state-metrics
    scheme: https
    metrics_path: /metrics

    basic_auth:
      username: "{{ kube_state_metrics_username }}"
      password_file: /etc/prometheus/secrets/kube-state-metrics-password

    static_configs:
      - targets:
          - metrics-internal.glefer.fr